import sys
import argparse


def main():
    parser = argparse.ArgumentParser(
        description="Sort shopping items and remove duplicates."
    )
    parser.add_argument(
        "-c", "--count",
        action="store_true",
        help="Show the number of each item."
    )
    args = parser.parse_args()

    items = {}

    for line in sys.stdin:
        item = line.strip()

        if not item:
            continue

        key = item.casefold()

        if key not in items:
            items[key] = [item, 0]

        items[key][1] += 1

    for key in sorted(items):
        name, count = items[key]

        if args.count:
            print(f"{name} {count}")
        else:
            print(name)


if __name__ == "__main__":
    main()
