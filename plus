import sys

x = 0
count = 0

for line in sys.stdin:
    try:
        x += int(line)
    except ValueError:
        try:
            x += float(line)
        except ValueError:
            sys.exit(1)
    count += 1

if count == 0:
    sys.exit(1)

print(x)
